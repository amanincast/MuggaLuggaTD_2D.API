# The muggalugga-web container: plain HTTP on :8080 behind the box's edge Caddy, which does TLS.
{
	auto_https off
	admin off
}

:8080 {
	encode gzip zstd
	header X-Robots-Tag "noindex, nofollow"

	# The launcher's files (step 4): a manifest that must never be cached, and content-addressed blobs
	# that never change once written.
	handle_path /downloads/* {
		root * /srv/downloads
		@manifest path *.json
		header @manifest Cache-Control "no-cache"
		@blobs path /blobs/*
		header @blobs Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/site
		file_server
	}
}
