# Copy to deploy/.env on the server (gitignored) and fill with fresh secrets:
#   openssl rand -hex 24        (database password)
#   openssl rand -base64 48     (JWT signing key)
POSTGRES_PASSWORD=
JWT_KEY=
# Game builds older than this are told to update (builds are 0.1.<commit count>).
CLIENT_MINIMUM_VERSION=0.1.0
# Where published builds live on the server (served at /downloads/). Default: deploy/downloads
# DOWNLOADS_DIR=/home/deploy/muggalugga-downloads
