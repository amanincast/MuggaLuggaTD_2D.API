{
  // The NPC factions' temperament (docs/design/npc-factions.md, Unity repo). Server-only: the client
  // never decides for a faction, so this is not one of the documents it syncs.
  //
  // Aggression: how often it acts, against an average of 1 (a full-strength faction of 1 acts about
  // once every six hours). Raid/Siege/Expand/Fortify: its lean, as relative weights. A lean, not a
  // limit (Mike, 2026-10-06): a siege with nothing ripe raids instead, an expansion with no wild land
  // left fortifies instead.
  "Factions": [
    {
      "Id": "Grimjaw",
      "Name": "The Grimjaw",
      "Lean": "raids often",
      "Aggression": 1.25,
      "Raid": 0.7,
      "Siege": 0.1,
      "Expand": 0.15,
      "Fortify": 0.05
    },
    {
      "Id": "Ashkin",
      "Name": "The Ashkin",
      "Lean": "entrenches, strikes hard",
      "Aggression": 0.8,
      "Raid": 0.35,
      "Siege": 0.3,
      "Expand": 0.1,
      "Fortify": 0.25
    },
    {
      // Seated by a Great Rift's eruption, never by generation (Invasions phase 6). They spread like a plague (Mike,
      // 2026-10-11): into wild land of any tier, leaning hard toward it. Expanding costs strength, so fighting them
      // back slows the spread. They never fortify: they did not come to stay safe.
      "Id": "Riftborn",
      "Name": "The Riftborn",
      "Lean": "spreads like a plague",
      "Aggression": 2.0,
      "Raid": 0.3,
      "Siege": 0.2,
      "Expand": 0.5,
      "Fortify": 0
    },
    // Factions 2, step 2 (spec §2.2). Drawn into a world's cast of three at generation; signature acts come with step 3.,
    {
      "Id": "DrownedCourt",
      "Name": "The Drowned Court",
      "Lean": "lays siege to the shore",
      "Aggression": 0.9,
      "Raid": 0.2,
      "Siege": 0.45,
      "Expand": 0.2,
      "Fortify": 0.15
    },
    {
      "Id": "BoneSynod",
      "Name": "The Bone Synod",
      "Lean": "holds what it takes",
