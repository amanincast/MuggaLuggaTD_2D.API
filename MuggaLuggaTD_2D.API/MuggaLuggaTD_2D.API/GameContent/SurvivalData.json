{
  // How long a PvE run is, and how its enemies scale.
  //
  // The combat scene paces the fight from these numbers and the server pays out the run's rewards
  // from them, so they must live in one place: if the two drifted, the server would pay for a fight
  // of a different length than the one actually fought.
  "WavesRequiredTier1": 3,
  "WavesRequiredTier2": 4,
  "WavesRequiredTier3": 5,
  "WavesRequiredTier4": 6,

  "EnemiesRequiredPerWave": 10,
  "EnemyLevelIncreaseInterval": 3,

  // Elites. From this wave on, some of the wave is an elite - x2 health, x1.25 damage, x1.5
  // experience - and one more elite joins every EliteIntervalWaves waves after that. The reward
  // calculator prices them from the same numbers the combat scene spawns them from.
  "ElitesFromWave": 3,
  "EliteIntervalWaves": 2,

  // The open-field wave arena (WavePlan; Mike, 2026-10-04). The numbers above still size and pay
  // placed fights (dungeons, ruins, a keep's road) and ambushes. Here each wave is a planned roster:
  // (first + added x (wave - 1)) x the tier's factor, dealt in over DealSeconds. The next wave comes
  // WaveSeconds after the last began, or BreatherSeconds after the field is clear, so a slow clearer
  // is swamped. A run pays PayGrowth x what the old ten-a-wave run did, spread over its enemies.
  "WaveArenaWavesTier1": 5,
  "WaveArenaWavesTier2": 6,
  "WaveArenaWavesTier3": 8,
  "WaveArenaWavesTier4": 10,
  "WaveArenaFirstWaveEnemies": 12,
  "WaveArenaEnemiesAddedPerWave": 4,
  "WaveArenaTierFactorTier1": 1.0,
  "WaveArenaTierFactorTier2": 1.25,
  "WaveArenaTierFactorTier3": 1.5,
  "WaveArenaTierFactorTier4": 2.0,
  "WaveArenaWaveSeconds": 30,
  "WaveArenaDealSeconds": 12,
  "WaveArenaBreatherSeconds": 2,
  "WaveArenaPayGrowth": 1.75,
  // The most enemies standing at once: dealing waits while the field is this full (a frame budget).
  "WaveArenaMostStanding": 150,

  // A representative enemy, used to value a kill (see RunRewardCalculator.ExperienceForEnemy).
  "BaseEnemyHealth": 50,
  "EnemyHealthMultiplierPerLevel": 0.15
}
