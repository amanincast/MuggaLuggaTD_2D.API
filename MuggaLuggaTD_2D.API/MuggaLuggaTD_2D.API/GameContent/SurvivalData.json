{
  // How long a PvE run is, and how its enemies scale.
  //
  // The combat scene paces the fight from these numbers and the server pays out the run's rewards
  // from them, so they must live in one place: if the two drifted, the server would pay for a fight
  // of a different length than the one actually fought.
  "WavesRequiredTier1": 3,
  "WavesRequiredTier2": 4,
  "WavesRequiredTier3": 5,
  "WavesRequiredTier4": 6,

  "EnemiesRequiredPerWave": 10,
  "EnemyLevelIncreaseInterval": 3,

  // Elites. From this wave on, some of the wave is an elite - x2 health, x1.25 damage, x1.5
  // experience - and one more elite joins every EliteIntervalWaves waves after that. The reward
  // calculator prices them from the same numbers the combat scene spawns them from.
  "ElitesFromWave": 3,
  "EliteIntervalWaves": 2,

  // A representative enemy, used to value a kill (see RunRewardCalculator.ExperienceForEnemy).
  "BaseEnemyHealth": 50,
  "EnemyHealthMultiplierPerLevel": 0.15
}
